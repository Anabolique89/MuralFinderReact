# MuralFinder React App Environment Variables

# Google Maps Configuration
VITE_MAP_KEY=your_google_maps_api_key_here
VITE_MAP_ID=your_google_maps_id_here

# Pusher Configuration (for real-time features)
VITE_PUSHER_KEY=your_pusher_key_here

# API Configuration
# Base URL for the MuralFinder API (without trailing slash)
# For local development: http://localhost:8000/api
# For production: https://api.muralfinder.net/api
VITE_API_BASE_URL=http://localhost:8000/api
